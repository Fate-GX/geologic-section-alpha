      ]
    },
    {
      "basisId": "PUBLISHED-EVENT-CONCEPT-EROSION",
      "basisType": "PublishedConceptualEvidence",
      "definition": "Erosion truncates pre-existing material before a younger depositional event; the precise supporting passages remain pending independent review.",
      "sourceIds": [
        "GA-GEOMODELLER-PRINCIPLES",
        "JSGI-LOGICAL-TREE-2008"
      ],
      "evidenceStatus": "PartiallySupported",
      "implementationRefs": [
        "subprojects/geologic_3d_engine/geologic_3d_engine/events/stratigraphic_events.py::apply_erosion"
      ],
      "testRefs": [
