      ]
    },
    {
      "basisId": "PUBLISHED-EVENT-CONCEPT-PINCHOUT",
      "basisType": "PublishedConceptualEvidence",
      "definition": "Pinchout is a lateral termination concept supported terminologically by NACSN; TEI-395 supplies a regional example where unit thickness reaches zero at local pinchout.",
      "sourceIds": [
        "NACSN-CODE-2021",
        "USGS-TEI395-PINCHOUT"
      ],
      "evidenceStatus": "PartiallySupported",
      "scopeBoundary": "TEI-395 is regional empirical evidence and does not establish a universal numerical algorithm.",
      "implementationRefs": [
        "subprojects/geologic_3d_engine/geologic_3d_engine/events/stratigraphic_events.py::classify_interval_evidence"
      ],
      "testRefs": [
        "subprojects/geologic_3d_engine/tests/test_stage3_events.py::test_conflicting_event_evidence_remains_unresolved"
      ]
    },
    {
      "basisId": "PUBLISHED-EVENT-CONCEPT-ONLAP",
      "basisType": "PublishedConceptualEvidence",
      "definition": "Onlap is represented by a younger depositional body terminating against an older event surface; the precise supporting passages remain pending independent review.",
      "sourceIds": [
        "GA-GEOMODELLER-PRINCIPLES"
      ],
      "evidenceStatus": "Verified",
      "implementationRefs": [
        "subprojects/geologic_3d_engine/geologic_3d_engine/events/stratigraphic_events.py::build_deposit_on_surface"
      ],
      "testRefs": [
        "subprojects/geologic_3d_engine/tests/test_stage3_events.py::test_onlap_preserves_existing_bodies_and_records_pinchout"
      ]
    },
    {
      "basisId": "PUBLISHED-EVENT-CONCEPT-NONDEPOSITION",
      "basisType": "PublishedConceptualEvidence",
      "definition": "Nondeposition represents elapsed geological time without requiring geometric removal; ICS is primary conceptual evidence and USGS Thesaurus is auxiliary terminology support.",
      "sourceIds": [
        "ICS-INTERNATIONAL-STRATIGRAPHIC-GUIDE-UNCONFORMITY",
        "USGS-THESAURUS-UNCONFORMITY"
      ],
      "evidenceStatus": "Verified",
      "scopeBoundary": "Do not equate nondeposition with erosion, missing record, nonpenetration, or every unconformity.",
