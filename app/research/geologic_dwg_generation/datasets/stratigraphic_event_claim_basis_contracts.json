  "basisContracts": [
    {
      "basisId": "PUBLISHED-EVENT-CONCEPT-DEPOSITION",
      "basisType": "PublishedConceptualEvidence",
      "definition": "Deposition adds younger material in a declared stratigraphic sequence; the precise supporting passages remain pending independent review.",
      "sourceIds": [
        "GA-GEOMODELLER-PRINCIPLES",
        "JSGI-LOGICAL-TREE-2008"
      ],
      "evidenceStatus": "PartiallySupported",
      "implementationRefs": [
        "subprojects/geologic_3d_engine/geologic_3d_engine/events/stratigraphic_events.py::build_deposit_on_surface"
      ],
      "testRefs": [
