  "basisContracts": [
    {
      "basisId": "DERIVATION-1D-CONSTANT-AREA-SOLID-VOLUME",
      "basisType": "MathematicalIdentity",
      "derivation": "For a one-dimensional column of unchanged reference area A, solid volume is Vs=A*H*(1-phi). If no solid is added or removed, cancellation of A gives H1*(1-phi1)=H2*(1-phi2).",
      "preconditions": ["unchanged reference area", "no solid addition or removal", "compatible porosity definitions"],
      "implementationRefs": ["subprojects/geologic_3d_engine/geologic_3d_engine/physics/compaction.py::solid_thickness", "subprojects/geologic_3d_engine/geologic_3d_engine/physics/compaction.py::transform_thickness"],
      "testRefs": ["tools/geologic_pattern_generator/test_universal_compaction_diagenesis.py::test_solid_volume_is_preserved"]
    },
    {
      "basisId": "DEFINITION-POROSITY-FRACTION",
      "basisType": "MathematicalIdentity",
      "derivation": "Porosity is void volume divided by total bulk volume; the executable model excludes the singular all-void state and therefore requires 0 <= phi < 1.",
      "implementationRefs": ["subprojects/geologic_3d_engine/geologic_3d_engine/physics/compaction.py::_porosity"],
      "testRefs": ["subprojects/geologic_3d_engine/tests/test_stage4_compaction.py"]
    },
    {
